{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "lib": ["ES2018", "DOM"],
    "outDir": "./static/js",
    "rootDir": "./src/ts",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "removeComments": false,
    "types": ["jquery", "bootstrap"]
  },
  "include": ["src/ts/**/*"]
}
