{
  "manifest_version": 3,
  "name": "High Score Ani Fetcher",
  "version": "1.0.0",
  "description": "Fetch and filter high score anime from Bahamut.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://ani.gamer.com.tw/*"],
  "background": {
    "service_worker": "src/background.ts"
  }
}
