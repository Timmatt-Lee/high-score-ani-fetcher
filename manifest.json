{
  "manifest_version": 3,
  "name": "巴哈動畫評分",
  "version": "1.0.1",
  "description": "Fetch and filter high score anime from 巴哈姆特動漫瘋.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "cookies",
    "scripting"
  ],
  "host_permissions": ["*://ani.gamer.com.tw/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background.ts"
  }
}
