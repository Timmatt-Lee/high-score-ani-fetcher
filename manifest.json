{
  "manifest_version": 3,
  "name": "巴哈動畫評分",
  "version": "1.0.1",
  "description": "Fetch and filter high score anime from 巴哈姆特動漫瘋.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://ani.gamer.com.tw/*"],
  "background": {
    "service_worker": "src/background.ts"
  }
}
